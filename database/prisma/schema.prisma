  PAID_LEAVE
  UNPAID_LEAVE
  PARTIALLY_PAID_LEAVE
  ABSENCE
  HOLIDAY

  @@schema("payroll")
}

enum WarningCode {
  MISSING_BANK_DETAILS
  MISSING_EMAIL
  MISSING_CONTRACT
  OVERLAPPING_CONTRACTS
  CONTRACT_PERIOD_GAP
  CONTRACT_EXPIRING
  MISSING_SCHEDULE
  STRUCTURE_MISMATCH
  DUPLICATE_PAYSLIP
  ATTENDANCE_EXCEPTION
  INSUFFICIENT_LEAVE_BALANCE
  NEGATIVE_NET_PAY
  RULE_COMPUTATION_ERROR
  CURRENCY_MISMATCH
  OTHER

  @@schema("payroll")
