// PeoplePay360 HR & Payroll - PostgreSQL / Prisma 7.
// PostgreSQL namespaces: auth, hr, attendance, leave, payroll, configuration.
// Connection: backend/prisma.config.ts. Design and workflow rules: ../SCHEMA_GUIDE.md.

generator client {
  provider = "prisma-client"
  output   = "../../backend/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth", "hr", "attendance", "leave", "payroll", "configuration"]
}

// -----------------------------------------------------------------------------
// Enumerations
// -----------------------------------------------------------------------------

model WorkspaceSettings {
  id               Int      @id @default(1)
  organizationName String   @default("Your organization") @db.VarChar(150)
  supportEmail     String?  @db.VarChar(254)
  defaultCurrency  String   @default("INR") @db.Char(3)
  timezone         String   @default("Asia/Kolkata") @db.VarChar(80)
  reportMonths     Int      @default(6)
  version          Int      @default(1)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  @@schema("configuration")
}

enum UserRole {
  USER
  MANAGER
  EMPLOYEE
  HR_MANAGER
  HR_PAYROLL_USER
  HR_PAYROLL_MANAGER
  ADMIN

  @@schema("auth")
}

enum PermissionAction {
  CREATE
  READ
  UPDATE
  DELETE
  APPROVE
  REFUSE
  COMPUTE
  VALIDATE
  MARK_PAID
  PRINT
  SEND
  MANAGE_PERMISSIONS

  @@schema("auth")
}

enum AccessScope {
  OWN
  ALL

  @@schema("auth")
}

enum EmployeeStatus {
  ONBOARDING
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
  ARCHIVED

  @@schema("hr")
}

enum EmployeeType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  TEMPORARY

  @@schema("hr")
}

enum EmploymentEventType {
  HIRED
  DEPARTMENT_CHANGED
  POSITION_CHANGED
  MANAGER_CHANGED
  SCHEDULE_CHANGED
  CONTRACT_CHANGED
  STATUS_CHANGED
  TERMINATED
  REHIRED

  @@schema("hr")
}

enum ContractStatus {
  DRAFT
  OPEN
  EXPIRED
  TERMINATED
  CANCELLED

  @@schema("hr")
}

enum WageBasis {
  MONTHLY
  HOURLY
  DAILY
  ANNUAL

  @@schema("hr")
}

enum ScheduleType {
  FULL_TIME
  PART_TIME
  FLEXIBLE
  SHIFT

  @@schema("configuration")
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY

  @@schema("configuration")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  ON_LEAVE
  HOLIDAY
  REST_DAY

  @@schema("attendance")
}

enum AttendanceSource {
  SELF_SERVICE
  MANUAL
  IMPORT
  DEVICE

  @@schema("attendance")
}

enum AttendanceExceptionType {
  MISSING_CHECK_OUT
  LATE
  EARLY_DEPARTURE
  OVERLAPPING_ENTRIES
  OUTSIDE_SCHEDULE
  EXCESSIVE_HOURS
  OTHER

  @@schema("attendance")
}

enum ExceptionStatus {
  OPEN
  RESOLVED
  DISMISSED

  @@schema("attendance")
}

enum LeaveUnit {
  DAYS
  HOURS

  @@schema("leave")
}

enum ApprovalPolicy {
  AUTOMATIC
  SINGLE_APPROVAL
  TWO_LEVEL_APPROVAL

  @@schema("leave")
}

enum AllocationApprovalPolicy {
  SINGLE_APPROVAL
  TWO_LEVEL_APPROVAL

  @@schema("leave")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REFUSED

  @@schema("leave")
}

enum LeavePayrollTreatment {
  PAID
  UNPAID
  PARTIALLY_PAID

  @@schema("leave")
}

enum LeaveStatus {
  DRAFT
  SUBMITTED
  FIRST_APPROVED
  APPROVED
  REFUSED
  CANCELLED

  @@schema("leave")
}

enum AllocationKind {
  REGULAR
  CARRY_FORWARD
  ADJUSTMENT

  @@schema("leave")
}

enum SalaryCategoryType {
  BASIC
  ALLOWANCE
  GROSS
  DEDUCTION
  EMPLOYER_CONTRIBUTION
  NET
  OTHER

  @@schema("configuration")
}

enum SalaryComputationMethod {
  FIXED
  PERCENTAGE
  FORMULA

  @@schema("configuration")
}

enum SalaryConditionMethod {
  ALWAYS
  RANGE
  FORMULA

  @@schema("configuration")
}

enum SalaryRuleEffect {
  EARNING
  DEDUCTION
  EMPLOYER_COST
  INFORMATIONAL

  @@schema("configuration")
}

enum PayFrequency {
  MONTHLY
  SEMI_MONTHLY
  BIWEEKLY
  WEEKLY
  CUSTOM

  @@schema("configuration")
}

enum PayrunStatus {
  DRAFT
  COMPUTING
  COMPUTED
  VALIDATED
  PARTIALLY_PAID
  PAID
  CANCELLED

  @@schema("payroll")
}

enum PayrunEmployeeStatus {
