  WARNING
  BLOCKING

  @@schema("payroll")
}

enum WarningStatus {
  OPEN
  RESOLVED
  ACKNOWLEDGED

  @@schema("payroll")
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REVERSED

  @@schema("payroll")
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CHEQUE
  OTHER

  @@schema("payroll")
}

enum DocumentStatus {
